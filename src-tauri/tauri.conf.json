{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterMoonDownloader",
  "version": "1.1.0",
  "identifier": "app.bettermoon.downloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BetterMoonDownloader",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Bulk downloader for fuckingfast.co and datanodes.to",
    "copyright": "MIT"
  }
}
